# Ortam degiskenleri sablonu
# Bu dosya repoya dahildir (.env.example) - gercek degerler icermez
# Kullanmak icin bu dosyayi .env olarak kopyalayin:
#   cp .env.example .env

# Veritabani baglanti bilgisi
# Lokal: SQLite (varsayilan)
# Bulut: Supabase PostgreSQL (Render uzerinde env var olarak ayarlanir)
DATABASE_URL=sqlite:///afet_verileri.db

# Google Gemini API anahtari
GEMINI_API_KEY=your_gemini_api_key_here

# NOT: Gercek veritabani URL'si (Supabase PostgreSQL) asla buraya yazilmaz!
# Bulut ortaminda:
#   - Render: Dashboard > Environment > DATABASE_URL
#   - GitHub Actions: Settings > Secrets > DATABASE_URL
# seklinde guvenli bicimde yonetilir.
